@model IEnumerable<PartsControlSystem.Models.ViewActivityMonitoring>
@{
    ViewData["Title"] = "Activity Monitoring";
    var allowedActivities = (List<string>)(ViewBag.AllowedActivities ?? new List<string>());
    var defaultActivity = (string)ViewBag.DefaultActivity;

    var allActivities = new[]
    {
        "Renewal / Additional Mold",
        "New Tooling / Localization",
        "Supplier Change / Localization",
        "Multiple Procurement / Localization",
        "Change Material",
        "Other 4M"
    };
}

<div class="card shadow-sm mb-3 border-0">
    <div class="card-body py-2">
        <div class="row align-items-center g-2">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Select Activity</label>
                @if (allowedActivities.Any())
                {
                    <select id="activitySelect" class="form-select form-select-sm">
                        @foreach (var act in allActivities)
                        {
                            if (allowedActivities.Contains(act))
                            {
                                <option value="@act" selected="@(act == defaultActivity)">@act</option>
                            }
                        }
                    </select>
                }
                else
                {
                    <select class="form-select form-select-sm" disabled>
                        <option>No activities available for your section</option>
                    </select>
                }
            </div>
        </div>
    </div>
</div>

<!-- Monitoring table container -->
<div id="monitoringContainer">
    @if (allowedActivities.Contains("Renewal / Additional Mold"))
    {
        <partial name="Partials/Monitoring/_RenewalMonitoring" model="Model" />
    }
    else if (allowedActivities.Any())
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted small">Loading monitoring data...</div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-3">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            Your section does not have access to any activity monitoring data.
        </div>
    }
</div>

<script>
    const activitySelect = document.getElementById('activitySelect');

    function loadMonitoring(activity) {
        const container = document.getElementById('monitoringContainer');
        container.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted small">Loading monitoring data...</div>
            </div>`;
        fetch('@Url.Action("GetMonitoringPartial", "UpdatePerActivity")'
            + '?activity=' + encodeURIComponent(activity))
            .then(res => res.text())
            .then(html => { container.innerHTML = html; })
            .catch(() => {
                container.innerHTML = `
                    <div class="alert alert-danger text-center mt-3">
                        Failed to load monitoring data.
                    </div>`;
            });
    }

    if (activitySelect) {
        activitySelect.addEventListener('change', function () {
            loadMonitoring(this.value);
        });

        // If default activity isn't Renewal (i.e. wasn't preloaded server-side), load it now
        const defaultActivity = '@Html.Raw(defaultActivity)';
        if (defaultActivity && defaultActivity !== 'Renewal / Additional Mold') {
            loadMonitoring(defaultActivity);
        }
    }
</script>